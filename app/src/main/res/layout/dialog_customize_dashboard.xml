<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_auto_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/customize_dashboard"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 1. Layout Preset -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/customize_layout_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgLayoutPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbPreset1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_preset_1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:padding="6dp" />

            <RadioButton
                android:id="@+id/rbPreset2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_preset_2"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:padding="6dp" />

            <RadioButton
                android:id="@+id/rbPreset3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_preset_3"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:padding="6dp" />
        </RadioGroup>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="16dp" />

        <!-- 2. Car / Vehicle Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/customize_car_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/car_model"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etCarModel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:background="@drawable/bg_pill_status"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:inputType="textCapWords" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/car_odometer"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etCarOdometer"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:background="@drawable/bg_pill_status"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/car_fuel"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etCarFuel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:background="@drawable/bg_pill_status"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/car_speed"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etCarSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:background="@drawable/bg_pill_status"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="16dp" />

        <!-- 3. Navigation Display Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_destination"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Улица / Цель"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etNavStreet"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:background="@drawable/bg_pill_status"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Расстояние манёвра"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etNavTurnDist"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:background="@drawable/bg_pill_status"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="16dp" />

        <!-- 4. Weather City -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_city"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etWeatherCity"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_pill_status"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:inputType="textCapWords"
            android:layout_marginBottom="20dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancelCustomization"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/cancel"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSaveCustomization"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/save"
                android:background="@drawable/bg_rail_item_active"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
