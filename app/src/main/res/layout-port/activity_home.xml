<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/sidebar_bg">

        <TextView
            android:id="@+id/bigClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16:42"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bigDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Пт, 10 окт."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginStart="8dp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/statusAuto"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            app:tint="@color/text_secondary"
            app:srcCompat="@drawable/ic_android_auto" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/statusBt"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            app:tint="@color/text_secondary"
            app:srcCompat="@drawable/ic_bluetooth" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/statusSignal"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:tint="@color/text_secondary"
            app:srcCompat="@drawable/ic_cell_signal" />

        <TextView
            android:id="@+id/tvSignalType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4G"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/wifiIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            app:tint="@color/text_secondary"
            app:srcCompat="@drawable/ic_wifi" />

        <LinearLayout
            android:id="@+id/statusWeatherPill"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_pill_status">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/statusWeatherIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                app:srcCompat="@drawable/ic_wx_partly" />

            <TextView
                android:id="@+id/statusWeatherTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12°C"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnCustomize"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:padding="5dp"
            android:background="@drawable/bg_circle_translucent"
            app:tint="@color/accent"
            app:srcCompat="@drawable/ic_edit" />
    </LinearLayout>

    <!-- Scrollable content for portrait -->
    <ScrollView
        android:id="@+id/dashboardContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/layoutPremium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDashboardSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DASHLINE AUTO"
                android:visibility="gone" />

            <!-- CARD 1: Nav Map Card -->
            <FrameLayout
                android:id="@+id/cardNav"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_auto_card"
                android:clipToOutline="true"
                android:layout_marginBottom="8dp">

                <com.dashline.launcher.LiveGpsMapView
                    android:id="@+id/liveGpsMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Turn Banner -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_turn_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        app:tint="#FFFFFF"
                        app:srcCompat="@drawable/ic_turn_left" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNavTurnDist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nav_turn_dist"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNavStreet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nav_street"
                            android:textColor="#DDFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Route info pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_status"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvNavRouteInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_route_info"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvNavEta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:54"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:layout_marginEnd="6dp" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnNavClose"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:padding="3dp"
                        app:tint="@color/text_secondary"
                        app:srcCompat="@drawable/ic_close" />
                </LinearLayout>

                <!-- Controls -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnNavZoomIn"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="5dp"
                        android:background="@drawable/bg_circle_translucent"
                        app:tint="#FFFFFF"
                        android:layout_marginBottom="6dp"
                        app:srcCompat="@drawable/ic_zoom_in" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnNavZoomOut"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="5dp"
                        android:background="@drawable/bg_circle_translucent"
                        app:tint="#FFFFFF"
                        android:layout_marginBottom="6dp"
                        app:srcCompat="@drawable/ic_zoom_out" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnNavRecenter"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="5dp"
                        android:background="@drawable/bg_circle_translucent"
                        app:tint="#FFFFFF"
                        app:srcCompat="@drawable/ic_recenter" />
                </LinearLayout>
            </FrameLayout>

            <!-- CARD 2: Dock -->
            <LinearLayout
                android:id="@+id/cardDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_auto_card"
                android:padding="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/shortcutAndroidAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="6dp"
                        android:background="@drawable/bg_aa_badge"
                        android:layout_marginEnd="8dp"
                        app:tint="#FFFFFF"
                        app:srcCompat="@drawable/ic_android_auto" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Android Auto"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAaStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/aa_connected"
                            android:textColor="@color/color_green"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dockAppsRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/dockApp1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <androidx.appcompat.widget.AppCompatImageView android:layout_width="28dp" android:layout_height="28dp" app:srcCompat="@drawable/ic_yandex_maps" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/dockApp2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <androidx.appcompat.widget.AppCompatImageView android:layout_width="28dp" android:layout_height="28dp" app:srcCompat="@drawable/ic_spotify" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/dockApp3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <androidx.appcompat.widget.AppCompatImageView android:layout_width="28dp" android:layout_height="28dp" app:srcCompat="@drawable/ic_yandex_music" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/dockApp4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <androidx.appcompat.widget.AppCompatImageView android:layout_width="28dp" android:layout_height="28dp" app:srcCompat="@drawable/ic_youtube_music" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 3: Media -->
            <LinearLayout
                android:id="@+id/cardMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_auto_card"
                android:padding="10dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/mediaArt"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:clipToOutline="true"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/art_bg"
                        app:tint="@color/text_primary"
                        app:srcCompat="@drawable/ic_audio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mediaArtist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Imagine Dragons"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/mediaTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Believer"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mediaAlbum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Evolve"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/mediaAppBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:srcCompat="@drawable/ic_spotify" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mediaSeekRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/mediaElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:42"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <SeekBar
                        android:id="@+id/mediaProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progress="55"
                        android:progressDrawable="@drawable/seek_progress"
                        android:thumb="@drawable/seek_thumb" />

                    <TextView
                        android:id="@+id/mediaTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-1:26"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mediaControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnPrev"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="6dp"
                        app:tint="#FFFFFF"
                        app:srcCompat="@drawable/ic_skip_previous" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnPlayPause"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:background="@drawable/btn_circle"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:tint="#FFFFFF"
                        app:srcCompat="@drawable/ic_pause" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnNext"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="6dp"
                        app:tint="#FFFFFF"
                        app:srcCompat="@drawable/ic_skip_next" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 4: Weather & CARD 5: Trip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:id="@+id/cardWeather"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_auto_card"
                    android:clipToOutline="true">



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/weatherIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="6dp"
                                app:srcCompat="@drawable/ic_wx_partly" />

                            <TextView
                                android:id="@+id/weatherTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12°C"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/weatherCity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weather_city_default"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/weatherDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weather_condition_sample"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <LinearLayout
                            android:id="@+id/forecastRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                                <TextView android:id="@+id/fc0Day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Сб" android:textSize="9sp" android:textColor="@color/text_secondary" />
                                <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc0Icon" android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@drawable/ic_wx_clear" />
                                <TextView android:id="@+id/fc0Temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14°" android:textSize="9sp" android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                                <TextView android:id="@+id/fc1Day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Вс" android:textSize="9sp" android:textColor="@color/text_secondary" />
                                <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc1Icon" android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@drawable/ic_wx_clear" />
                                <TextView android:id="@+id/fc1Temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16°" android:textSize="9sp" android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                                <TextView android:id="@+id/fc2Day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Пн" android:textSize="9sp" android:textColor="@color/text_secondary" />
                                <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc2Icon" android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@drawable/ic_wx_cloudy" />
                                <TextView android:id="@+id/fc2Temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12°" android:textSize="9sp" android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/cardTrip"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_auto_card"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvTripTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trip_title"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTripFuel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8,9 л/100 км"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvTripSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="62 км/ч"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTripOdometer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="124 500 км"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCarModelBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mazda CX-5"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>


                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Rail for Portrait -->
    <LinearLayout
        android:id="@+id/sidebarRail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@color/sidebar_bg">

        <LinearLayout android:id="@+id/homeButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_rail_item_active">
            <androidx.appcompat.widget.AppCompatImageView android:layout_width="22dp" android:layout_height="22dp" app:tint="#FFFFFF" app:srcCompat="@drawable/ic_home" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navMap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
            <androidx.appcompat.widget.AppCompatImageView android:layout_width="22dp" android:layout_height="22dp" app:tint="@color/icon_tint" app:srcCompat="@drawable/ic_nav" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navMusic" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
            <androidx.appcompat.widget.AppCompatImageView android:layout_width="22dp" android:layout_height="22dp" app:tint="@color/icon_tint" app:srcCompat="@drawable/ic_audio" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navPhone" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
            <androidx.appcompat.widget.AppCompatImageView android:layout_width="22dp" android:layout_height="22dp" app:tint="@color/icon_tint" app:srcCompat="@drawable/ic_phone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navApps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
